# Переменные, обязательные для сборки, которая поедет в магазин или на прод.
# Настоящий .env в git не хранится — здесь только имена.
# Проверяет их scripts/check-release-env.js, он же останавливает сборку.

# Идентификатор приложения в Яндекс ID. НЕ секрет (в отличие от client_secret,
# который живёт только на бэкенде), но без него из собранного приложения молча
# исчезает вход через Яндекс — сборка при этом проходит успешно.
REACT_APP_YANDEX_CLIENT_ID=

# Необязательна: в src/api.js есть рабочее продовое значение по умолчанию.
# Задавайте, только если нужно указать другой бэкенд.
# REACT_APP_API_URL=

# Необязательна: используется, чтобы собственные тестовые заходы не засоряли
# цели в Метрике.
# REACT_APP_OWNER_EMAIL=
