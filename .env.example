# Адрес API-бэкенда (familyflow-api). Без переменной используется прод-адрес
# по умолчанию из src/api.js — для локальной разработки против своего API
# укажите его здесь.
REACT_APP_API_URL=http://localhost:3001

# Client ID приложения на oauth.yandex.ru (не секрет, можно светить в браузере —
# в отличие от Client Secret, который живёт только на бэкенде, см. familyflow-api).
# Без переменной кнопка «Войти с Яндекс ID» просто не показывается (см. api.js).
REACT_APP_YANDEX_CLIENT_ID=

# Email, которым сами тестируете прод (регистрации/входы под ним не должны
# засорять цели Яндекс.Метрики). Без переменной фильтрация просто выключена —
# ничего не ломается, но и не фильтруется.
REACT_APP_OWNER_EMAIL=
